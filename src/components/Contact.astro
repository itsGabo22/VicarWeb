<section id='contacto' class='contact'>
  <div class='container'>
    <div class='contact-grid'>
      <div class='contact-info'>
        <h2 class='section-title'>
          ¿Listo para <span class='bg-gradient'>elevar</span> tu marca?
        </h2>
        <p>
          No busques una web, busca un activo digital. Cuéntame sobre tu
          proyecto y hagámoslo realidad.
        </p>

        <div class='contact-methods'>
          <a href='mailto:vicardev2026@gmail.com' class='method'>
            <div class='icon'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                width='20'
                height='20'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
                ><rect width='20' height='16' x='2' y='4' rx='2'></rect><path
                  d='m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7'></path></svg
              >
            </div>
            <span>vicardev2026@gmail.com</span>
          </a>
          <a href='https://wa.me/573164172093' target='_blank' rel='noopener' class='method'>
            <div class='icon'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                width='20'
                height='20'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
                ><path
                  d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z'
                ></path></svg
              >
            </div>
            <span>WhatsApp / 3164172093</span>
          </a>
          <a
            href='https://www.instagram.com/vicar.dev?igsh=MTF3Ynh5emh6NThlaQ=='
            target='_blank'
            rel='noopener'
            class='method'
          >
            <div class='icon'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                width='20'
                height='20'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
                ><rect width='20' height='20' x='2' y='2' rx='5' ry='5'
                ></rect><path
                  d='M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z'
                ></path><line x1='17.5' x2='17.51' y1='6.5' y2='6.5'
                ></line></svg
              >
            </div>
            <span>Instagram / @vicar.dev</span>
          </a>
        </div>
      </div>

      <form
        action='https://formspree.io/f/xlggelwg'
        method='POST'
        class='contact-form'
        id='contact-form'
        novalidate
      >
        <div class='form-group'>
          <label for='name'>Nombre</label>
          <input
            type='text'
            id='name'
            name='name'
            placeholder='Tu nombre'
            autocomplete='name'
            minlength='2'
            required
            aria-describedby='name-error'
          />
          <span class='field-error' id='name-error' aria-live='polite'></span>
        </div>
        <div class='form-group'>
          <label for='email'>Email</label>
          <input
            type='email'
            id='email'
            name='email'
            placeholder='tu@email.com'
            autocomplete='email'
            required
            aria-describedby='email-error'
          />
          <span class='field-error' id='email-error' aria-live='polite'></span>
        </div>
        <div class='form-group'>
          <label for='message'>Proyecto</label>
          <textarea
            id='message'
            name='message'
            rows='4'
            placeholder='Cuéntame sobre tu idea...'
            minlength='10'
            required
            aria-describedby='message-error'></textarea>
          <span class='field-error' id='message-error' aria-live='polite'></span>
        </div>
        <!-- Honeypot para evitar spam -->
        <input
          type='text'
          name='_gotcha'
          style='display:none'
          tabindex='-1'
          autocomplete='off'
        />
        <input type='hidden' name='_subject' value='Nuevo mensaje desde vicardev.digital' />
        <button type='submit' class='btn-submit'>Enviar Propuesta</button>
        <p class='form-status' id='form-status' role='status' aria-live='polite'></p>
      </form>
    </div>
  </div>
</section>

<script>
  const contactSection = document.getElementById('contacto');
  if (contactSection) {
    const updateMousePos = (x: number, y: number) => {
      contactSection.style.setProperty('--mouse-x', `${x}px`);
      contactSection.style.setProperty('--mouse-y', `${y}px`);
    };

    contactSection.addEventListener('mousemove', (e) => {
      const rect = contactSection.getBoundingClientRect();
      updateMousePos(e.clientX - rect.left, e.clientY - rect.top);
    });

    contactSection.addEventListener(
      'touchmove',
      (e) => {
        if (e.touches.length > 0) {
          const rect = contactSection.getBoundingClientRect();
          updateMousePos(
            e.touches[0].clientX - rect.left,
            e.touches[0].clientY - rect.top
          );
        }
      },
      { passive: true }
    );
  }
  /* --- Envío del formulario (Formspree vía fetch) --- */
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector('#form-status') as HTMLElement;
    const button = form.querySelector('.btn-submit') as HTMLButtonElement;
    const fields = ['name', 'email', 'message'] as const;
    const messages: Record<(typeof fields)[number], string> = {
      name: 'Escribe tu nombre (mínimo 2 caracteres).',
      email: 'Escribe un email válido, por ejemplo tu@email.com.',
      message: 'Cuéntame un poco más sobre tu proyecto (mínimo 10 caracteres).',
    };

    const validateField = (name: (typeof fields)[number]) => {
      const input = form.elements.namedItem(name) as HTMLInputElement;
      const error = form.querySelector(`#${name}-error`) as HTMLElement;
      input.value = input.value.trimStart();
      const valid = input.checkValidity() && input.value.trim().length > 0;
      input.setAttribute('aria-invalid', String(!valid));
      error.textContent = valid ? '' : messages[name];
      return valid;
    };

    fields.forEach((name) => {
      const input = form.elements.namedItem(name) as HTMLInputElement;
      input.addEventListener('blur', () => validateField(name));
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true') validateField(name);
      });
    });

    const setStatus = (text: string, state: 'ok' | 'error' | 'sending') => {
      status.innerHTML = text;
      status.dataset.state = state;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const results = fields.map(validateField);
      if (results.includes(false)) {
        const firstInvalid = fields[results.indexOf(false)];
        (form.elements.namedItem(firstInvalid) as HTMLElement).focus();
        setStatus('Revisa los campos marcados.', 'error');
        return;
      }

      button.disabled = true;
      button.textContent = 'Enviando...';
      setStatus('', 'sending');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        setStatus('¡Mensaje enviado! Te responderé pronto a tu email.', 'ok');
      } catch {
        setStatus(
          'No se pudo enviar el mensaje. Inténtalo de nuevo o escríbeme por <a href="https://wa.me/573164172093" target="_blank" rel="noopener">WhatsApp</a>.',
          'error'
        );
      } finally {
        button.disabled = false;
        button.textContent = 'Enviar Propuesta';
      }
    });
  }
</script>

<style>
  .contact {
    padding: var(--section-padding);
    background: #050505;
    position: relative;
    overflow: hidden;
  }

  /* Interactive Background - Different color for Contact */
  .contact::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      800px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(157, 0, 255, 0.4),
      transparent 40%
    );
    z-index: 0;
    pointer-events: none;
    /* Avoid overflow shift on mobile */
    overflow: hidden;
  }

  .contact .container {
    position: relative;
    z-index: 1;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1.5rem;
  }

  .bg-gradient {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .contact-info p {
    color: var(--text-secondary);
    font-size: 1.2rem;
    margin-bottom: 3rem;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .method {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: var(--transition-smooth);
  }

  .method:hover {
    border-color: var(--accent-cyan);
    background: rgba(6, 182, 212, 0.05);
    transform: translateX(10px);
  }

  .icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-cyan);
    transition: var(--transition-smooth);
  }

  .method:hover .icon {
    background: var(--gradient-primary);
    color: white;
  }

  /* Form Styles */
  .contact-form {
    background: rgba(20, 20, 20, 0.6);
    backdrop-filter: blur(20px);
    padding: 3rem;
    border-radius: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.8rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-weight: 500;
    margin-left: 0.5rem;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1.2rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    color: white;
    font-family: inherit;
    outline: none;
    transition: var(--transition-smooth);
    font-size: 1rem;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--accent-blue);
    background: rgba(37, 99, 235, 0.05);
    box-shadow: 0 0 20px rgba(37, 99, 235, 0.1);
  }

  .btn-submit {
    width: 100%;
    padding: 1.2rem;
    background: var(--gradient-primary);
    border: none;
    border-radius: 1rem;
    color: white;
    font-weight: 800;
    cursor: pointer;
    transition: var(--transition-smooth);
    font-size: 1.1rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: wait;
    transform: none;
  }

  .field-error {
    display: block;
    min-height: 1.2em;
    margin: 0.4rem 0 0 0.5rem;
    font-size: 0.85rem;
    color: #f87171;
  }

  .form-group input[aria-invalid='true'],
  .form-group textarea[aria-invalid='true'] {
    border-color: #f87171;
  }

  .form-status {
    margin-top: 1.5rem;
    text-align: center;
    font-weight: 500;
  }

  .form-status:empty {
    display: none;
  }

  .form-status[data-state='ok'] {
    color: #4ade80;
  }

  .form-status[data-state='error'] {
    color: #f87171;
  }

  .form-status a {
    text-decoration: underline;
  }

  .btn-submit:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(37, 99, 235, 0.3);
  }

  @media (max-width: 900px) {
    .section-title {
      text-align: center;
      margin-inline: auto;
    }
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      overflow: hidden;
    }
    .contact-info,
    .contact-form {
      min-width: 0; /* Evita que el email desborde la columna y se recorte */
    }
    .method {
      padding: 1rem;
    }
    .method span {
      font-size: 0.9rem;
      overflow-wrap: break-word;
      min-width: 0;
    }
    .contact-methods {
      align-items: center; /* Center flex items */
    }
    .method {
      width: 100%; /* Full width cards */
      justify-content: center;
    }

    .contact-form {
      padding: 2rem;
    }
  }
</style>
