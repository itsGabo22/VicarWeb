---
const projects = [
  {
    id: 'bluevelvet',
    title: 'Blue Velvet',
    category: 'E-commerce Premium',
    description:
      'Plataforma de moda de alta gama con enfoque en la experiencia de usuario y conversiones optimizadas.',
    image: 'images/bluevelvet.jpeg',
    tags: ['Node.js', 'Firebase', 'JS', 'UI/UX'],
    link: 'https://bluevelvet0.com',
    type: 'static',
  },
  {
    id: 'comingsoon',
    title: 'Próximamente',
    category: 'Futuros Proyectos',
    description:
      'Nuevas experiencias digitales de alta gama están en camino. Este espacio pronto será ocupado por software que respira.',
    image:
      'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&q=80&w=800',
    tags: ['VICAR', 'Digital Design'],
    isComingSoon: true,
    type: 'warp',
  },
];
---

<section id='proyectos' class='projects'>
  <!-- Dynamic Backgrounds -->
  <div class='bg-layer active' id='bg-bluevelvet'>
    <!-- 
      MODIFICAR AQUI EL EFECTO:
      filter: blur(8px) -> Aumenta el numero pixeles para más borroso, disminuye para mas nitido.
      opacity: 0.6 -> Opacidad del overlay negro sobre el video (0 a 1).
    -->
    <div class='video-container' style='filter: blur(8px) brightness(0.6);'>
      <!-- Reemplazar 'videos/bluevelvet-loop.mp4' con la ruta de tu video -->
      <!-- Si no tienes el video aún, puedes descomentar la linea de bg-image abajo -->
      <!-- <div class="bg-image" style="background-image: url('images/bluevelvet.jpeg');"></div> 
       public\videos\background_BV.mp4-->

      <video autoplay muted loop playsinline class='bg-video'>
        <source src='videos/background_BV.mp4' type='video/mp4' />
        <!-- Fallback image -->
        <img src='images/bluevelvet.jpeg' alt='Background' />
      </video>
    </div>
  </div>

  <div class='bg-layer' id='bg-warp'>
    <canvas id='warp-canvas'></canvas>
  </div>

  <div class='container content-wrapper'>
    <div class='header'>
      <h2 class='section-title'>
        Casos de <span class='bg-gradient'>Éxito</span>
      </h2>
      <p class='section-desc'>Explorando el estándar VICAR.</p>
    </div>

    <div class='carousel-wrapper'>
      <div class='projects-track'>
        {
          projects.map((project, index) => (
            <div
              class={`project-card ${project.isComingSoon ? 'coming-soon' : ''}`}
              data-type={project.type}
              data-index={index}
            >
              <div class='image-container'>
                <img src={project.image} alt={project.title} loading='lazy' />
                <div class='overlay'>
                  <span class='category'>{project.category}</span>
                </div>
              </div>
              <div class='card-content'>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <div class='tags'>
                  {project.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
                {project.link && (
                  <a href={project.link} target='_blank' class='project-link'>
                    Visitar Sitio
                    <svg
                      xmlns='http://www.w3.org/2000/svg'
                      width='16'
                      height='16'
                      viewBox='0 0 24 24'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='2'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                    >
                      <path d='M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6' />
                      <polyline points='15 3 21 3 21 9' />
                      <line x1='10' y1='14' x2='21' y2='3' />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Indicators -->
    <div class='indicators'>
      {
        projects.map((_, index) => (
          <button
            class={`indicator-dot ${index === 0 ? 'active' : ''}`}
            data-index={index}
            aria-label={`Ir al slide ${index + 1}`}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  /* --- Warp Speed Effect --- */
  const canvas = document.getElementById('warp-canvas') as HTMLCanvasElement;
  const ctx = canvas ? canvas.getContext('2d') : null;

  let animationId: number;
  let isWarpActive = false;

  // Resize canvas
  function resizeCanvas() {
    if (canvas) {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
  }
  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  const stars: Star[] = [];
  const STAR_COUNT = 400; // More density
  const SPEED = 25; // High speed

  class Star {
    x: number;
    y: number;
    z: number;
    pz: number;

    constructor() {
      // Initialize with default values to satisfy TypeScript
      this.x = 0;
      this.y = 0;
      this.z = 0;
      this.pz = 0;
      this.reset(true);
    }

    reset(initial = false) {
      if (!canvas) return;
      this.x = (Math.random() * 2 - 1) * canvas.width;
      this.y = (Math.random() * 2 - 1) * canvas.height;
      this.z = Math.random() * canvas.width;
      this.pz = this.z;
      if (!initial) this.z = canvas.width; // Respawn far away
    }

    update() {
      this.z -= SPEED;
      if (this.z <= 0) this.reset();
    }

    draw() {
      if (!canvas || !ctx) return;

      const cx = canvas.width / 2;
      const cy = canvas.height / 2;

      const x = (this.x / this.z) * 100 + cx;
      const y = (this.y / this.z) * 100 + cy;

      const px = (this.x / this.pz) * 100 + cx;
      const py = (this.y / this.pz) * 100 + cy;

      this.pz = this.z;

      if (x < 0 || x > canvas.width || y < 0 || y > canvas.height) return;

      const size = (1 - this.z / canvas.width) * 4;
      const alpha = 1 - this.z / canvas.width;

      ctx.beginPath();
      // Trail effect
      ctx.strokeStyle = `rgba(100, 200, 255, ${alpha})`;
      ctx.lineWidth = size;
      ctx.moveTo(px, py);
      ctx.lineTo(x, y);
      ctx.stroke();
    }
  }

  // Init stars
  for (let i = 0; i < STAR_COUNT; i++) stars.push(new Star());

  function animateWarp() {
    if (!isWarpActive || !canvas || !ctx) return;

    ctx.fillStyle = 'rgba(0, 0, 0, 0.4)'; // Trails
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    stars.forEach((star) => {
      star.update();
      star.draw();
    });

    animationId = requestAnimationFrame(animateWarp);
  }

  function startWarp() {
    if (isWarpActive) return;
    isWarpActive = true;
    animateWarp();
  }

  function stopWarp() {
    isWarpActive = false;
    cancelAnimationFrame(animationId);
  }

  /* --- Carousel Logic --- */
  const track = document.querySelector('.carousel-wrapper');
  const cards = document.querySelectorAll('.project-card');
  const dots = document.querySelectorAll('.indicator-dot');
  const bgBlueVelvet = document.getElementById('bg-bluevelvet');
  const bgWarp = document.getElementById('bg-warp');

  const observer = new IntersectionObserver(
    (entries) => {
      // Find the entry with the highest intersection ratio
      let maxRatio = 0;
      let activeEntry: any = null; // Forced 'any' to silence unresolved TS error

      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.intersectionRatio > maxRatio) {
          maxRatio = entry.intersectionRatio;
          activeEntry = entry;
        }
      });

      if (activeEntry && maxRatio > 0.5) {
        const indexStr = activeEntry.target.getAttribute('data-index');
        if (!indexStr) return;

        const index = parseInt(indexStr);
        const type = activeEntry.target.getAttribute('data-type');

        // Update dots
        dots.forEach((d) => d.classList.remove('active'));
        if (dots[index]) dots[index].classList.add('active');

        // Update Backgrounds
        if (type === 'static' && bgBlueVelvet && bgWarp) {
          bgBlueVelvet.style.opacity = '1';
          bgWarp.style.opacity = '0';
          stopWarp();
          // Ensure video plays if available
          const video = bgBlueVelvet.querySelector('video');
          if (video) {
            video.play().catch(() => {});
          }
        } else if (type === 'warp' && bgBlueVelvet && bgWarp) {
          bgBlueVelvet.style.opacity = '0';
          bgWarp.style.opacity = '1';
          startWarp();
          const video = bgBlueVelvet.querySelector('video');
          if (video && !video.paused) {
            video.pause();
          }
        }
      }
    },
    {
      threshold: 0.6,
      root: track,
    }
  );

  cards.forEach((card) => observer.observe(card));
</script>

<style>
  .projects {
    padding: var(--section-padding);
    background: #000;
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Background Layers */
  .bg-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    transition: opacity 1s ease-in-out;
    opacity: 0;
  }

  .bg-layer.active {
    opacity: 1;
  }

  .bg-image,
  .bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.1);
  }

  .video-container {
    width: 100%;
    height: 100%;
    /* Transition for blur effect changes if needed dynamically */
    transition: filter 0.5s ease;
  }

  #warp-canvas {
    width: 100%;
    height: 100%;
    background: black;
  }

  .content-wrapper {
    position: relative;
    z-index: 10;
  }

  .header {
    margin-bottom: 2rem;
    text-align: left;
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 0.5rem;
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
  }

  .bg-gradient {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Carousel */
  .carousel-wrapper {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0 2rem;
    scroll-snap-type: x mandatory;
    display: flex;
    align-items: center;
    height: 600px; /* Limit height for better desktop feel */
  }

  .projects-track {
    display: flex;
    gap: 4rem;
    padding: 0 max(2rem, calc(50vw - 400px)); /* Center the 800px card */
  }

  .project-card {
    width: 800px;
    max-width: 90vw;
    height: 450px;
    flex-shrink: 0;
    background: rgba(13, 13, 13, 0.85);
    backdrop-filter: blur(20px);
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    scroll-snap-align: center;
    display: flex;
    flex-direction: row;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
    transition: transform 0.6s ease;
  }

  /* Active card effect (via scroll snap centering implicity, usually scale comes from intersection but simple transform here works) */
  .project-card:hover {
    transform: scale(1.02);
  }

  .image-container {
    width: 50%;
    position: relative;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-content {
    width: 50%;
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .category {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
  }

  .card-content h3 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .card-content p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: 2rem;
    /* Prevent overflow on mobile */
    word-break: break-word;
  }

  .tags {
    display: flex;
    gap: 0.8rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    margin-top: auto;
    color: white;
  }

  .indicators {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .indicator-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    cursor: pointer;
    transition: all 0.3s;
  }

  .indicator-dot.active {
    background: var(--accent-cyan);
    transform: scale(1.3);
    box-shadow: 0 0 10px var(--accent-cyan);
  }

  @media (max-width: 900px) {
    .header {
      text-align: center; /* Center title on mobile */
    }
    .section-title {
      white-space: normal; /* Allow title to wrap */
      line-height: 1.2;
    }
    .project-card {
      flex-direction: column;
      height: auto;
      width: 85vw;
      /* Ensure scroll snap centers it */
      scroll-snap-align: center;
      margin: 0 auto;
    }
    .image-container,
    .card-content {
      width: 100%;
    }
    .image-container {
      height: 200px;
    }
    .projects-track {
      display: flex;
      gap: 1.5rem;
      /* Calculate width to ensure it exceeds viewport for scrolling */
      /* 2 cards at 85vw each + gap + padding = wider than 100vw */
      width: auto;
      padding: 0;
    }
    .carousel-wrapper {
      width: 100vw;
      margin-left: calc(-50vw + 50%); /* Full width breakout */
      padding: 2rem 7.5vw; /* Side padding for first card centering */
      height: auto;
      overflow-x: scroll;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      display: flex;
      justify-content: flex-start;
      scrollbar-width: none; /* Hide scrollbar */
    }
    .carousel-wrapper::-webkit-scrollbar {
      display: none; /* Hide scrollbar for webkit */
    }

    /* Center text on mobile */
    .card-content h3 {
      font-size: 1.5rem; /* Smaller font to avoid cut */
    }
  }
</style>
