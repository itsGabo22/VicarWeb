---
import { getCollection } from 'astro:content';

// Los proyectos viven en src/data/projects.json (ver src/content.config.ts)
const projects = (await getCollection('projects'))
  .map((entry) => ({ id: entry.id, ...entry.data }))
  .sort((a, b) => a.order - b.order);
---

<section id='proyectos' class='projects'>
  <!-- Fondos dinámicos: uno por proyecto, se activa el de la tarjeta visible -->
  {
    projects.map((project, index) => (
      <div
        class={`bg-layer ${index === 0 ? 'active' : ''}`}
        data-bg-index={index}
        aria-hidden='true'
      >
        <!--
          MODIFICAR AQUI EL EFECTO:
          blur(8px) -> Aumenta el numero de pixeles para más borroso, disminuye para más nítido.
          brightness(0.6) -> Oscurece el fondo (0 a 1).
        -->
        <div class='video-container' style='filter: blur(8px) brightness(0.6);'>
          {project.bgVideo ? (
            <video
              muted
              loop
              playsinline
              preload='none'
              poster={project.bgVideo.poster}
              class='bg-video'
            >
              <source src={project.bgVideo.src} type='video/mp4' />
            </video>
          ) : (
            <img
              src={project.image.src}
              alt=''
              width={project.image.width}
              height={project.image.height}
              loading='lazy'
              decoding='async'
              class='bg-image'
            />
          )}
        </div>
      </div>
    ))
  }

  <div class='container content-wrapper'>
    <div class='header'>
      <h2 class='section-title'>
        Casos de <span class='bg-gradient'>Éxito</span>
      </h2>
      <p class='section-desc'>
        {projects.length} proyectos en producción. Explorando el estándar VICAR.
      </p>
    </div>

    <div class='carousel-wrapper'>
      <div class='projects-track'>
        {
          projects.map((project, index) => (
            <article
              class='project-card'
              id={`caso-${project.id}`}
              data-index={index}
            >
              <div class='image-container'>
                <img
                  src={project.image.src}
                  alt={project.image.alt}
                  width={project.image.width}
                  height={project.image.height}
                  loading='lazy'
                  decoding='async'
                />
                <div class='overlay'>
                  <span class='category'>{project.badge}</span>
                </div>
              </div>
              <div class='card-content'>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <ul class='features'>
                  {project.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
                <div class='tags' aria-label='Tecnologías'>
                  {project.stack.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
                <a
                  href={project.url}
                  target='_blank'
                  rel='noopener'
                  class='project-link'
                >
                  Visitar sitio
                  <span class='sr-only'>de {project.title} (abre en una pestaña nueva)</span>
                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    width='16'
                    height='16'
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='2'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    aria-hidden='true'
                  >
                    <path d='M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6' />
                    <polyline points='15 3 21 3 21 9' />
                    <line x1='10' y1='14' x2='21' y2='3' />
                  </svg>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Indicadores -->
    <div class='indicators'>
      {
        projects.map((project, index) => (
          <button
            class={`indicator-dot ${index === 0 ? 'active' : ''}`}
            data-index={index}
            aria-label={`Ver ${project.title}`}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  /* --- Carousel Logica --- */
  const projectsSection = document.getElementById('proyectos');
  const track = document.querySelector('.carousel-wrapper');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  const dots = document.querySelectorAll<HTMLElement>('.indicator-dot');
  const layers = document.querySelectorAll<HTMLElement>('.bg-layer');

  let activeIndex = 0;
  let sectionVisible = false;

  // Solo reproduce el video del fondo activo y solo si la sección está en pantalla
  function syncVideos() {
    layers.forEach((layer, i) => {
      const video = layer.querySelector('video');
      if (!video) return;
      if (i === activeIndex && sectionVisible) {
        video.play().catch(() => {});
      } else if (!video.paused) {
        video.pause();
      }
    });
  }

  function setActive(index: number) {
    activeIndex = index;
    dots.forEach((d, i) => d.classList.toggle('active', i === index));
    layers.forEach((l, i) => l.classList.toggle('active', i === index));
    syncVideos();
  }

  const observer = new IntersectionObserver(
    (entries) => {
      // La tarjeta con mayor área visible es la activa
      let maxRatio = 0;
      let activeEntry: IntersectionObserverEntry | null = null;

      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.intersectionRatio > maxRatio) {
          maxRatio = entry.intersectionRatio;
          activeEntry = entry;
        }
      });

      if (activeEntry && maxRatio > 0.5) {
        const indexStr = (activeEntry as IntersectionObserverEntry).target.getAttribute('data-index');
        if (indexStr) setActive(parseInt(indexStr));
      }
    },
    {
      threshold: 0.6,
      root: track,
    }
  );

  cards.forEach((card) => observer.observe(card));

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      cards[i]?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    });
  });

  if (projectsSection) {
    const visibilityObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          sectionVisible = entry.isIntersecting;
          syncVideos();
        });
      },
      { threshold: 0 }
    );
    visibilityObserver.observe(projectsSection);
  }
</script>

<style>
  .projects {
    padding: var(--section-padding);
    background: #000;
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Background Layers */
  .bg-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    transition: opacity 0.5s ease-in-out;
    opacity: 0;
    will-change: opacity;
  }

  .bg-layer.active {
    opacity: 1;
  }

  .bg-image,
  .bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.1);
  }

  .video-container {
    width: 100%;
    height: 100%;
    /* Transición del efecto dinámicamente */
    transition: filter 0.5s ease;
  }

  .content-wrapper {
    position: relative;
    z-index: 10;
  }

  .header {
    margin-bottom: 2rem;
    text-align: left;
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 0.5rem;
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
  }

  .section-desc {
    color: var(--text-secondary);
  }

  .bg-gradient {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Carousel */
  .carousel-wrapper {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0 2rem;
    scroll-snap-type: x mandatory;
    display: flex;
    align-items: center;
    height: 620px; /* Límite para mejor optimización*/
  }

  .carousel-wrapper::-webkit-scrollbar {
    display: none;
  }

  .projects-track {
    display: flex;
    gap: 4rem;
    padding: 0 max(2rem, calc(50vw - 440px)); /* Centra la tarjeta de 880px */
  }

  .project-card {
    width: 880px;
    max-width: 90vw;
    height: 520px;
    flex-shrink: 0;
    background: rgba(13, 13, 13, 0.85);
    backdrop-filter: blur(20px);
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    scroll-snap-align: center;
    scroll-margin-top: 7rem; /* Compensa la barra fija al llegar por ancla */
    display: flex;
    flex-direction: row;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
    transition: transform 0.6s ease;
  }

  .project-card:hover {
    transform: scale(1.02);
  }

  .image-container {
    width: 45%;
    position: relative;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .card-content {
    width: 55%;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .category {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
  }

  .card-content h3 {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .card-content p {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 1.25rem;
    /* Prevent overflow on mobile */
    word-break: break-word;
  }

  .features {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .features li {
    position: relative;
    padding-left: 1.4rem;
  }

  .features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--gradient-primary);
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .tags span {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 2rem;
    border: 1px solid rgba(6, 182, 212, 0.4);
    color: var(--accent-cyan);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: white;
  }

  .project-link:hover {
    color: var(--accent-cyan);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .indicators {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .indicator-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    cursor: pointer;
    transition: all 0.3s;
  }

  .indicator-dot.active {
    background: var(--accent-cyan);
    transform: scale(1.3);
    box-shadow: 0 0 10px var(--accent-cyan);
  }

  @media (max-width: 900px) {
    .header {
      text-align: center; /* Center title on mobile */
    }
    .section-title {
      white-space: normal; /* Allow title to wrap */
      line-height: 1.2;
    }
    .project-card {
      flex-direction: column;
      height: auto;
      width: 85vw;
      /* Ensure scroll snap centers it */
      scroll-snap-align: center;
      margin: 0 auto;
    }
    .image-container,
    .card-content {
      width: 100%;
    }
    .image-container {
      height: 200px;
    }
    .card-content {
      padding: 1.75rem;
    }
    .projects-track {
      display: flex;
      gap: 1.5rem;

      width: auto;
      padding: 0;
    }
    .carousel-wrapper {
      width: 100vw;
      margin-left: calc(-50vw + 50%);
      padding: 2rem 7.5vw;
      height: auto;
      overflow-x: scroll;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      display: flex;
      justify-content: flex-start;
      scrollbar-width: none; /* Esconder scrollbar */
      align-items: stretch;
    }

    /* Center text on mobile */
    .card-content h3 {
      font-size: clamp(1.2rem, 5vw, 1.5rem); /* Responsive fluid font size */
      line-height: 1.2;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }
  }
</style>
