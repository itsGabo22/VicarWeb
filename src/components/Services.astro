---
const services = [
  {
    title: 'E-commerce',
    description:
      'Tiendas online con catálogo por categorías, filtros, variantes de producto, carrito y pedidos por WhatsApp.',
    icon: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z',
    caseId: 'brisal',
    caseTitle: 'Brisal by Salvador',
  },
  {
    title: 'Landing Pages',
    description:
      'Páginas de servicios con SEO local, formulario de cotización, preguntas frecuentes y contacto directo por WhatsApp.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    caseId: 'electrotech',
    caseTitle: 'ElectroTech',
  },
  {
    title: 'Portales Mayoristas',
    description:
      'Registro y acceso para mayoristas y distribuidores, con niveles de compra y aprobación de cuentas.',
    icon: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z',
    caseId: 'carlin',
    caseTitle: 'Carlin Cosméticos',
  },
];
---

<section id='servicios' class='services'>
  <div class='container'>
    <div class='grid'>
      {
        services.map((service) => (
          <div class='service-card'>
            <div class='icon-box'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                fill='none'
                viewBox='0 0 24 24'
                stroke-width='1.5'
                stroke='currentColor'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d={service.icon}
                />
              </svg>
            </div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <a href={`#caso-${service.caseId}`} class='case-link'>
              Ver caso: {service.caseTitle} →
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Lazy Initialize Vanta Net Effect: three.js y Vanta se descargan solo al llegar a la sección
  const loadScript = (src: string) =>
    new Promise<void>((resolve, reject) => {
      const script = document.createElement('script');
      script.src = src;
      script.onload = () => resolve();
      script.onerror = reject;
      document.head.appendChild(script);
    });

  let vantaLoading: Promise<void> | null = null;
  const loadVanta = () =>
    (vantaLoading ??= loadScript(
      'https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js'
    ).then(() =>
      loadScript('https://cdnjs.cloudflare.com/ajax/libs/vanta/0.5.24/vanta.net.min.js')
    ));

  // @ts-ignore
  document.addEventListener('astro:page-load', () => {
    const servicesSection = document.getElementById('servicios');
    let vantaEffect: any = null;

    if (servicesSection) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              loadVanta().then(() => {
                // @ts-ignore
                if (window.VANTA && !vantaEffect) {
                  // @ts-ignore
                  vantaEffect = window.VANTA.NET({
                    el: '#servicios',
                    mouseControls: true,
                    touchControls: true,
                    gyroControls: false,
                    minHeight: 200.0,
                    minWidth: 200.0,
                    scale: 1.0,
                    scaleMobile: 1.0,
                    color: 0x2563eb,
                    backgroundColor: 0x050505,
                    points: 12.0,
                    maxDistance: 22.0,
                    spacing: 18.0,
                  });
                }
              }).catch(() => {});
            } else {
              // Optional: Destroy when not visible to save memory
              // but for Vanta sometimes it's better to just keep it once initialized
              // if (vantaEffect) {
              //   vantaEffect.destroy();
              //   vantaEffect = null;
              // }
            }
          });
        },
        { threshold: 0.1 }
      );

      observer.observe(servicesSection);
    }
  });
</script>

<style>
  .services {
    padding: var(--section-padding);
    /* Background handled by Vanta.js, but keep base color */
    background: #050505;
    position: relative;
    overflow: hidden;
  }

  /* Ensure content is above Vanta canvas */
  .container {
    position: relative;
    z-index: 10;
    width: 100%;
    margin: 0 auto;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    width: 100%;
  }

  .service-card {
    padding: 3rem 2rem;
    background: rgba(13, 13, 13, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 1.5rem;
    transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    text-align: center;
    position: relative;
    overflow: hidden;
    width: 100%; /* Ensure card takes full available width in its grid cell */
    max-width: 400px; /* Prevent cards from getting too wide */
    margin-inline: auto; /* Center card within grid cell */
  }

  .service-card:hover {
    border-color: rgba(6, 182, 212, 0.3);
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
      justify-content: center;
      padding: 0 1rem;
    }
  }

  .icon-box {
    width: 70px;
    height: 70px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2rem;
    color: var(--accent-cyan);
    transition: var(--transition-smooth);
    position: relative;
    z-index: 1;
  }

  .service-card:hover .icon-box {
    background: var(--gradient-primary);
    color: white;
    transform: scale(1.1) rotate(5deg);
    border-color: transparent;
    box-shadow: 0 10px 20px rgba(37, 99, 235, 0.3);
  }

  .icon-box svg {
    width: 32px;
    height: 32px;
  }

  .service-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
  }

  .service-card p {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }

  .case-link {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent-cyan);
    position: relative;
    z-index: 1;
  }

  .case-link:hover {
    color: white;
  }
</style>
