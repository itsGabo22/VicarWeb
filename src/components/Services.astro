---
const services = [
  {
    title: 'Landing Pages',
    description:
      'Conversión máxima con diseños que guían al usuario y tecnologías que cargan al instante.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    title: 'E-commerce',
    description:
      'Tiendas online robustas, escalables y visualmente impactantes que elevan tu marca.',
    icon: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z',
  },
  {
    title: 'IA Optimization',
    description:
      'Integración de IA para automatizar flujos y optimizar el rendimiento del software.',
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  },
];
---

<section id='servicios' class='services'>
  <div class='container'>
    <div class='grid'>
      {
        services.map((service) => (
          <div class='service-card'>
            <div class='icon-box'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                fill='none'
                viewBox='0 0 24 24'
                stroke-width='1.5'
                stroke='currentColor'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d={service.icon}
                />
              </svg>
            </div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Vanta.js Scripts -->
<script
  is:inline
  src='https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js'
></script>
<script
  is:inline
  src='https://cdnjs.cloudflare.com/ajax/libs/vanta/0.5.24/vanta.net.min.js'
></script>

<script>
  // Initialize Vanta Net Effect
  // @ts-ignore
  document.addEventListener('astro:page-load', () => {
    // @ts-ignore
    if (window.VANTA) {
      // @ts-ignore
      window.VANTA.NET({
        el: '#servicios',
        mouseControls: true,
        touchControls: true,
        gyroControls: false,
        minHeight: 200.0,
        minWidth: 200.0,
        scale: 1.0,
        scaleMobile: 1.0,
        color: 0x2563eb, // Blue
        backgroundColor: 0x050505, // Dark background
        points: 12.0,
        maxDistance: 22.0,
        spacing: 18.0,
      });
    }
  });

  // Fallback for initial load
  window.addEventListener('load', () => {
    // @ts-ignore
    if (window.VANTA) {
      // @ts-ignore
      window.VANTA.NET({
        el: '#servicios',
        mouseControls: true,
        touchControls: true,
        gyroControls: false,
        minHeight: 200.0,
        minWidth: 200.0,
        scale: 1.0,
        scaleMobile: 1.0,
        color: 0x2563eb,
        backgroundColor: 0x050505,
        points: 12.0,
        maxDistance: 22.0,
        spacing: 18.0,
      });
    }
  });
</script>

<style>
  .services {
    padding: var(--section-padding);
    /* Background handled by Vanta.js, but keep base color */
    background: #050505;
    position: relative;
    overflow: hidden;
  }

  /* Ensure content is above Vanta canvas */
  .container {
    position: relative;
    z-index: 10;
  }

  .container {
    position: relative;
    z-index: 1;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    justify-items: center; /* Force center alignment */
  }

  .service-card {
    padding: 3rem 2rem;
    background: rgba(13, 13, 13, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 1.5rem;
    transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  /* Interactive Background handled by Vanta.js */
  /* Previous ::before interactive mask removed */

  /* Hover effect handling cleaned up for Vanta compatibility */

  .service-card:hover {
    border-color: rgba(6, 182, 212, 0.3);
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .icon-box {
    width: 70px;
    height: 70px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2rem;
    color: var(--accent-cyan);
    transition: var(--transition-smooth);
    position: relative;
    z-index: 1;
  }

  .service-card:hover .icon-box {
    background: var(--gradient-primary);
    color: white;
    transform: scale(1.1) rotate(5deg);
    border-color: transparent;
    box-shadow: 0 10px 20px rgba(37, 99, 235, 0.3);
  }

  .icon-box svg {
    width: 32px;
    height: 32px;
  }

  .service-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
  }

  .service-card p {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }
</style>
