---
const services = [
  {
    title: 'Landing Pages',
    description:
      'Conversión máxima con diseños que guían al usuario y tecnologías que cargan al instante.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    title: 'E-commerce',
    description:
      'Tiendas online robustas, escalables y visualmente impactantes que elevan tu marca.',
    icon: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z',
  },
  {
    title: 'IA Optimization',
    description:
      'Integración de IA para automatizar flujos y optimizar el rendimiento del software.',
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  },
];
---

<section id='servicios' class='services'>
  <div class='container'>
    <div class='grid'>
      {
        services.map((service) => (
          <div class='service-card'>
            <div class='icon-box'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                fill='none'
                viewBox='0 0 24 24'
                stroke-width='1.5'
                stroke='currentColor'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d={service.icon}
                />
              </svg>
            </div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    padding: var(--section-padding);
    background: var(--bg-dark);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .service-card {
    padding: 3rem 2rem;
    background: linear-gradient(145deg, #0d0d0d 0%, #050505 100%);
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 1.5rem;
    transition: var(--transition-smooth);
    text-align: center;
  }

  .service-card:hover {
    border-color: var(--accent-blue);
    transform: scale(1.02);
    box-shadow: 0 0 30px rgba(37, 99, 235, 0.1);
  }

  .icon-box {
    width: 60px;
    height: 60px;
    background: rgba(37, 99, 235, 0.1);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2rem;
    color: var(--accent-cyan);
  }

  .icon-box svg {
    width: 30px;
    height: 30px;
  }

  .service-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .service-card p {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
  }
</style>
