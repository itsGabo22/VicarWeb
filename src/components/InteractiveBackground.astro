<div class='mouse-cursor-gradient'></div>

<script>
  const gradient = document.querySelector(
    '.mouse-cursor-gradient'
  ) as HTMLElement;

  if (gradient) {
    let ticking = false;

    document.addEventListener('mousemove', (e) => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const x = e.clientX;
          const y = e.clientY;

          gradient.style.background = `
            radial-gradient(800px circle at ${x}px ${y}px, rgba(37, 99, 235, 0.25), transparent 40%),
            radial-gradient(400px circle at ${x}px ${y}px, rgba(6, 182, 212, 0.15), transparent 30%)
          `;
          ticking = false;
        });
        ticking = true;
      }
    });
  }
</script>

<style>
  .mouse-cursor-gradient {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    transition: background 0.1s ease; /* Faster transition for responsiveness */
    mix-blend-mode: screen; /* Blends better with dark background */
  }
</style>
